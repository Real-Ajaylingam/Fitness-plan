# Rename this file to .env and fill in your key.
GOOGLE_API_KEY=your_gemini_api_key_here

# Optional overrides (defaults shown). Gemini 1.5 models are retired and
# will 404 - do not use them. As of Sept 2026, gemini-2.5-pro/flash are
# still live but scheduled to shut down Oct 16, 2026, so these default to
# the Gemini 3 line instead:
GEMINI_PRO_MODEL=gemini-3.1-pro-preview
GEMINI_FLASH_MODEL=gemini-3.5-flash
